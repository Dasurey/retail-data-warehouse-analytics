	column TramoRecencia =
			SWITCH (
			    TRUE (),
			    ClientesFugados[DiasSinComprar] <= 30, "0–30 d",
			    ClientesFugados[DiasSinComprar] <= 60, "31–60 d",
			    ClientesFugados[DiasSinComprar] <= 90, "61–90 d",
			    "> 90 d"
			)
		dataType: string
		lineageTag: bcef144a-57cf-41d6-afa6-1be377a38e08
		summarizeBy: none
		sortByColumn: TramoRecenciaOrden

	column TramoRecenciaOrden =
			SWITCH (
			    TRUE (),
			    ClientesFugados[DiasSinComprar] <= 30, 1,
			    ClientesFugados[DiasSinComprar] <= 60, 2,
			    ClientesFugados[DiasSinComprar] <= 90, 3,
			    4
			)
		dataType: int64
		formatString: 0
		lineageTag: c5cf37a9-95ea-46c5-a89b-589514f3d35e
		summarizeBy: none

