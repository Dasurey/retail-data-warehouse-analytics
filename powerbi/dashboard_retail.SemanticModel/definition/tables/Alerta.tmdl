table Alerta
	lineageTag: f12aeef9-a38f-41ba-8f92-4074ca60f3ee

	measure Color_Estado =
			
			SWITCH(
			    SELECTEDVALUE('Alerta'[Estado]),
			    "NUEVA", "#994A15",      -- Código HEX del Marrón
			    "EN_REVISION", "#21429A",-- Código HEX del Azul
			    "RESUELTA", "#1E7145",   -- Código HEX del Verde
			    "DESCARTADA", "#607D8B", -- Código HEX del Gris
			    "#000000"                -- Negro por defecto si hay error
			)
		lineageTag: 271c1866-bb00-4a98-9bae-b6ccc822425a

