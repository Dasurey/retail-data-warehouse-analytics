	column 'Estado Limpio' =
			
			SWITCH(
			    'Alerta'[Estado],
			    "EN_REVISION", "En revisión",
			    "NUEVA", "Nueva",
			    "RESUELTA", "Resuelta",
			    "DESCARTADA", "Descartada",
			    'Alerta'[Estado] -- Esto deja el texto original si llega a aparecer un estado nuevo no contemplado
			)
		lineageTag: 504d61c1-8761-4a63-84ff-968b7d901cd4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Alerta = m
		mode: import
		source =
				let
				  Origen = Sql.Databases(".\SQLEXPRESS"),
				  #"Navegación 1" = Origen{[Name = "DW_Supermercado"]}[Data],
				  #"Navegación 2" = #"Navegación 1"{[Schema = "app", Item = "Alerta"]}[Data]
				in
				  #"Navegación 2"

	annotation PBI_NavigationStepName = Navegación

