table _Medidas
	lineageTag: 510b3e28-460f-4422-b270-e68f55a06010

	measure 'Días Promedio de Resolución' =
			
			AVERAGEX (
			    FILTER (
			        Alerta,
			        Alerta[Estado] = "RESUELTA"
			            && NOT ISBLANK ( Alerta[FechaResolucion] )
			    ),
			    DATEDIFF ( Alerta[FechaCreacion], Alerta[FechaResolucion], DAY )
			)
		lineageTag: 4e75c236-04f7-4178-8e1d-02611757f0b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Clientes Recuperados 60d' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( AccionRetencion[ClienteKey] ),
			        VAR Cli       = AccionRetencion[ClienteKey]
			        VAR FContacto = CALCULATE ( MAX ( AccionRetencion[FechaEnvio] ) )
			        VAR Compras   =
			            CALCULATE (
			                COUNTROWS ( FactVentas ),
			                TREATAS ( { Cli }, DimCliente[ClienteKey] ),
			                REMOVEFILTERS ( DimTiempo ),
			                DATESBETWEEN ( DimTiempo[Fecha], FContacto + 1, FContacto + 60 )
			            )
			        RETURN
			            Compras > 0
			    )
			)
		formatString: 0
		lineageTag: bdafa0e8-7450-44c3-afb2-331da31d0922

	measure 'Inflación Mensual Config' =
			
			LOOKUPVALUE (
			    Parametros[ValorNumerico],
			    Parametros[Clave], "INFLACION_MENSUAL_ESPERADA"
			)
		lineageTag: 5028d8b4-a27e-4fbf-85dd-bb0f1dbd87ec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tasa Recuperación 60d' = ```
			
			VAR Tasa = 
			    DIVIDE (
			        [Clientes Recuperados 60d],
			        DISTINCTCOUNT ( AccionRetencion[ClienteKey] )
			    )
			RETURN
			    -- Si por alguna razón da en blanco, muestra 0% formateado prolijamente
			    COALESCE(Tasa, 0)
			```
		lineageTag: 9dbc41aa-63a4-492f-90ba-ec8f8aa6310b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Unidades = SUM ( FactVentas[Cantidad] )
		lineageTag: a6bba9d0-3dfc-44dd-bcd5-cfd2e2067206

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Unidades MM3' =
			
			CALCULATE (
			    AVERAGEX ( VALUES ( DimTiempo[MesIndice] ), CALCULATE ( [Unidades] ) ),
			    DATESINPERIOD ( DimTiempo[Fecha], MAX ( DimTiempo[Fecha] ), -3, MONTH )
			)
		lineageTag: a5da9ebb-8b95-49ee-9908-dafe0741fa06

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Var % Unidades YoY' =
			
			VAR Actual = [Unidades]
			VAR Previo =
			    CALCULATE ( [Unidades], SAMEPERIODLASTYEAR ( DimTiempo[Fecha] ) )
			RETURN
			    DIVIDE ( Actual - Previo, Previo )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: fa1f218a-4e0a-41cc-9f99-c644d2586fa6

	measure 'Venta a Moneda Constante' =
			
			VAR Tasa     = [Inflación Mensual Config]
			VAR MesCorte =
			    CALCULATE ( MAX ( DimTiempo[MesIndice] ), ALL ( DimTiempo ) )
			RETURN
			    SUMX (
			        VALUES ( DimTiempo[MesIndice] ),
			        CALCULATE ( [Venta Neta] )
			            * POWER ( 1 + Tasa, MesCorte - DimTiempo[MesIndice] )
			    )
		lineageTag: a3328325-e542-43dd-8920-0995fdc5c46d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Venta Neta' = SUM ( FactVentas[ImporteNeto] )
		lineageTag: 3ace116a-1919-48a7-9f7f-f1c36159915b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Venta Neta YTD' = CALCULATE([Venta Neta], DATESYTD(DimTiempo[Fecha]))
