	measure 'Var % Nominal YoY' =
			
			VAR Actual = [Venta Neta]
			VAR Previo = CALCULATE ( [Venta Neta], SAMEPERIODLASTYEAR ( DimTiempo[Fecha] ) )
			RETURN DIVIDE ( Actual - Previo, Previo )
		lineageTag: 938376ac-7002-42b2-a7ff-35fae2e65cd5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Inflación Anual Esperada' =
			
			VAR TasaMensual = [Inflación Mensual Config]
			RETURN POWER ( 1 + TasaMensual, 12 ) - 1
		lineageTag: 56fc8352-50a0-4edc-b984-a96cb3d9b165

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Var % Moneda Constante YoY' =
			
			VAR Actual = [Venta a Moneda Constante]
			VAR Previo = CALCULATE ( [Venta a Moneda Constante], SAMEPERIODLASTYEAR ( DimTiempo[Fecha] ) )
			RETURN DIVIDE ( Actual - Previo, Previo )
		lineageTag: 5dc98e71-9081-41d7-8d7f-9c79be16e990

