	measure 'Estado Acción Fidelización' =
			VAR _Cli = MAX ( ClientesFugados[ClienteKey] )
			VAR _Env =
			    CALCULATE ( COUNTROWS ( AccionRetencion ), TREATAS ( { _Cli }, AccionRetencion[ClienteKey] ) )
			VAR _Can =
			    CALCULATE (
			        COUNTROWS ( AccionRetencion ),
			        TREATAS ( { _Cli }, AccionRetencion[ClienteKey] ),
			        AccionRetencion[FechaCanje] <> BLANK ()
			    )
			RETURN
			    SWITCH ( TRUE (), _Env = 0, "Sin contactar", _Can > 0, "Cupón canjeado", "Contactado" )
		lineageTag: 14fca7e1-6d7c-4a00-91c4-c3da8ced32cc

	measure 'Color Acción Fidelización' =
			SWITCH (
			    [Estado Acción Fidelización],
			    "Sin contactar", "#B91C1C",
			    "Contactado", "#92400E",
			    "Cupón canjeado", "#1E40AF",
			    "#5C6B66"
			)
		lineageTag: d500a0ca-5649-4765-87f3-0eaba62df134

	measure 'Fondo Acción Fidelización' =
			SWITCH (
			    [Estado Acción Fidelización],
			    "Sin contactar", "#FEE2E2",
			    "Contactado", "#FEF3C7",
			    "Cupón canjeado", "#DBEAFE",
			    "#EEF1F0"
			)
		lineageTag: 45ad1a35-2c75-49a2-b9c4-8e057adfb638

	measure 'Contactados Fidelización' = DISTINCTCOUNT ( AccionRetencion[ClienteKey] )
		formatString: 0
		lineageTag: f309426c-aacb-4e77-b14a-ee1504952664

	measure 'Tasa de Canje Fidelización' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( AccionRetencion ), AccionRetencion[FechaCanje] <> BLANK () ),
			    COUNTROWS ( AccionRetencion )
			)
		formatString: 0.0\ %
		lineageTag: 4f722e41-2b25-47b1-81cb-579d8fb565e9

	measure 'Ingreso Recuperado 60d Fidelización' =
			SUMX (
			    VALUES ( AccionRetencion[ClienteKey] ),
			    VAR _Cli = AccionRetencion[ClienteKey]
			    VAR _Contacto = CALCULATE ( MAX ( AccionRetencion[FechaEnvio] ) )
			    RETURN
			        CALCULATE (
			            [Venta Neta],
			            TREATAS ( { _Cli }, DimCliente[ClienteKey] ),
			            REMOVEFILTERS ( DimTiempo ),
			            DATESBETWEEN ( DimTiempo[Fecha], _Contacto + 1, _Contacto + 60 )
			        )
			)
		formatString: $ #,0
		lineageTag: 9f6dd7b4-5dfb-4273-9c96-4cbaead1c3f7

	measure 'Etiqueta Fugados Fidelización' = [Clientes Fugados Fidelización] & " clientes alto valor"
		lineageTag: cd71b970-627f-477f-b9d5-3370552a1478

	measure 'Etiqueta Peso Venta Fidelización' = "de la venta neta del período"
		lineageTag: 1f520a21-3f3c-406b-93bc-3603085cbac3

	measure 'Etiqueta Recuperados Fidelización' = [Clientes Recuperados 60d] & " clientes recuperados"
		lineageTag: ee6a223b-e92c-4833-9624-ea478b842928

	measure 'Lectura Ejecutiva Fidelización' =
			[Clientes Fugados Fidelización] & " clientes de alto valor concentran "
			    & FORMAT ( [Ingreso en Riesgo Fidelización] / 1000000, "$ #,0.0" ) & " M en riesgo ("
			    & FORMAT ( [% Ingreso en Riesgo s/ Venta Fidelización], "0.0 %" ) & " de la venta). Se recuperó el "
			    & FORMAT ( [Tasa Recuperación 60d], "0 %" ) & " de los contactados."
		lineageTag: f15c5cb6-acfa-406a-9371-2f79cb7934d0

	measure 'Var % Moneda Constante YoY Página 2' =
			VAR AnioActual = MAX ( DimTiempo[Anio] )
			VAR MesActual = MAX ( DimTiempo[Mes] )
			VAR UsaContextoMensual = HASONEVALUE ( DimTiempo[Mes] )
			VAR Actual =
			    IF (
			        UsaContextoMensual,
			        CALCULATE ( [Venta a Moneda Constante], REMOVEFILTERS ( DimTiempo ), DimTiempo[Anio] = AnioActual, DimTiempo[Mes] = MesActual ),
			        CALCULATE ( [Venta a Moneda Constante], REMOVEFILTERS ( DimTiempo ), DimTiempo[Anio] = AnioActual )
			    )
			VAR Previo =
			    IF (
			        UsaContextoMensual,
			        CALCULATE ( [Venta a Moneda Constante], REMOVEFILTERS ( DimTiempo ), DimTiempo[Anio] = AnioActual - 1, DimTiempo[Mes] = MesActual ),
			        CALCULATE ( [Venta a Moneda Constante], REMOVEFILTERS ( DimTiempo ), DimTiempo[Anio] = AnioActual - 1 )
			    )
			RETURN DIVIDE ( Actual - Previo, Previo )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 6f754139-c4ca-4cef-9086-81ff1dbcd7ee

	measure 'Zona Cuadrante Página 2' =
			VAR VarNominal = [Var % Nominal YoY Página 2]
			VAR VarUnidades = [Var % Unidades YoY Página 2]
			VAR Inflacion = [Inflación Anual Esperada]
			RETURN
			    SWITCH (
			        TRUE (),
			        VarUnidades > 0, "Crece de verdad",
			        VarNominal > Inflacion, "Solo remarca precios",
			        "Cae disfrazado de crecimiento"
			    )
		lineageTag: 2246557a-98d4-4cee-a886-bd02558a5052

	measure 'Color Zona Cuadrante Página 2' =
			SWITCH (
			    [Zona Cuadrante Página 2],
			    "Crece de verdad", "#0E6B4E",
			    "Solo remarca precios", "#92400E",
			    "#B91C1C"
			)
		lineageTag: 6abcdf3b-b7f9-4d93-b233-27efa95206d1

	measure 'Color Fuente Heatmap Página 2' =
			VAR _v = [Selector Métrica Valor Página 2]
			RETURN IF ( _v >= 0.12 || _v <= -0.06, "#FFFFFF", "#152420" )
		lineageTag: 485090f1-eb4b-4223-8442-a1e3a9786b0f

	measure 'Selector Métrica Valor 2024 Página 2' =
			-- Año de la línea gris: cambiá el 2024 si querés comparar otros años
			CALCULATE ( [Selector Métrica Valor Página 2], DimTiempo[Anio] = 2024 )
		formatString: +0.0\ %;-0.0\ %;0.0\ %
		lineageTag: bc8cb997-939b-48e6-9d45-f08f1be3ee78

	measure 'Selector Métrica Valor 2025 Página 2' =
			-- Año de la línea verde: cambiá el 2025 si querés comparar otros años
			CALCULATE ( [Selector Métrica Valor Página 2], DimTiempo[Anio] = 2025 )
		formatString: +0.0\ %;-0.0\ %;0.0\ %
		lineageTag: b710beb1-f841-4c16-b2fa-ec529238031d

	measure 'Selector Métrica MM3 Página 2' =
			-- Media móvil de 3 meses de la métrica elegida, solo para el año de la línea verde (2025)
			VAR _m = MAX ( DimTiempo[Mes] )
			VAR _v0 = CALCULATE ( [Selector Métrica Valor 2025 Página 2], REMOVEFILTERS ( DimTiempo[NombreMes] ), DimTiempo[Mes] = _m )
			VAR _v1 = CALCULATE ( [Selector Métrica Valor 2025 Página 2], REMOVEFILTERS ( DimTiempo[NombreMes] ), DimTiempo[Mes] = _m - 1 )
			VAR _v2 = CALCULATE ( [Selector Métrica Valor 2025 Página 2], REMOVEFILTERS ( DimTiempo[NombreMes] ), DimTiempo[Mes] = _m - 2 )
			RETURN
			    AVERAGEX ( { _v0, _v1, _v2 }, [Value] )
		formatString: +0.0\ %;-0.0\ %;0.0\ %
		lineageTag: dce06c24-b2f9-40fb-9b42-42c50fdb65f0

	measure 'Score Zona Página 2' =
			-- Resume el cuadrante en un número de -1 (todo mal) a +1 (todo bien) para colorear los círculos con degradado.
			-- Promedia dos señales: unidades (+10 % o más = +1) y crecimiento nominal contra la inflación (+20 puntos o más = +1).
			VAR EscalaUnidades = 0.10
			VAR EscalaNominal = 0.20
			VAR Unidades = [Var % Unidades YoY Página 2]
			VAR Nominal = [Var % Nominal YoY Página 2]
			VAR SenalUnidades = MAX ( -1, MIN ( 1, DIVIDE ( Unidades, EscalaUnidades ) ) )
			VAR SenalNominal = MAX ( -1, MIN ( 1, DIVIDE ( Nominal - [Inflación Anual Esperada], EscalaNominal ) ) )
			RETURN
			    IF ( ISBLANK ( Unidades ) || ISBLANK ( Nominal ), BLANK (), ( SenalUnidades + SenalNominal ) / 2 )
		formatString: 0.00
		lineageTag: 542eff9a-03b4-4ead-886c-1063b17095cf

	measure 'Tasa Recuperación 60d Promedio Fidelización' =
			-- Promedio de todas las acciones: es la línea de referencia del gráfico de efectividad (igual al K3)
			CALCULATE (
			    [Tasa Recuperación 60d],
			    REMOVEFILTERS ( AccionRetencion[Canal] ),
			    REMOVEFILTERS ( AccionRetencion[PctDescuento] )
			)
		formatString: 0\ %
		lineageTag: e47b4559-bb81-4bca-b970-bd5770febf35

	measure 'Umbral Racha Moderada Supply Chain' = 3
		formatString: 0
		lineageTag: b9af93d4-d3bd-43e2-9904-8c8d7a4a304c

	measure 'Rachas en Curso Supply Chain' =
			-- Rachas abiertas en cada mes (con varios meses en contexto suma racha-meses)
			VAR _meses = VALUES ( DimTiempo[MesIndice] )
			RETURN
			CALCULATE (
			    SUMX (
			        RachasQuiebre,
			        VAR _ini = YEAR ( RachasQuiebre[MesInicio] ) * 12 + MONTH ( RachasQuiebre[MesInicio] )
			        VAR _fin = YEAR ( RachasQuiebre[MesFin] ) * 12 + MONTH ( RachasQuiebre[MesFin] )
			        RETURN COUNTROWS ( FILTER ( _meses, DimTiempo[MesIndice] >= _ini && DimTiempo[MesIndice] <= _fin ) )
			    ),
			    REMOVEFILTERS ( DimTiempo )
			)
		formatString: 0
		lineageTag: a010a26e-d572-4b9a-ab03-57907f13c476

	measure 'Venta Perdida Racha Supply Chain' =
			-- Total acumulado de cada racha (scatter y tabla: una fila o punto = una racha)
			SUM ( RachasQuiebre[VentaPerdidaEstimada] )
		formatString: $ #,0
		lineageTag: c6b525db-a434-45c5-907e-9744ae79560e

	measure 'Duración Promedio Supply Chain' = AVERAGE ( RachasQuiebre[SnapshotsEnQuiebre] )
		formatString: 0.0
		lineageTag: 6caea09a-826c-4cf1-8f15-abd88d044123

	measure 'Duración Mediana Supply Chain' = MEDIAN ( RachasQuiebre[SnapshotsEnQuiebre] )
		formatString: 0
		lineageTag: 550efcf5-ab3a-4d25-9279-a2563252d04a

	measure 'Duración Promedio vs AA Supply Chain' =
			[Duración Promedio Supply Chain]
			    - CALCULATE ( [Duración Promedio Supply Chain], SAMEPERIODLASTYEAR ( DimTiempo[Fecha] ) )
		formatString: +0.0;-0.0;0.0
		lineageTag: 653a6964-176c-4cdc-8040-4409d4d448df

	measure 'Fecha Ancla Supply Chain' =
			MIN (
			    CALCULATE ( MAX ( DimTiempo[Fecha] ), ALLSELECTED ( DimTiempo ) ),
			    EOMONTH ( CALCULATE ( MAX ( RachasQuiebre[MesFin] ), REMOVEFILTERS () ), 0 )
			)
		lineageTag: f98618db-8f72-4e27-b9c6-ebe5b72117b5

	measure 'Venta Perdida Ult 3M Supply Chain' =
			VAR _corte = EOMONTH ( [Fecha Ancla Supply Chain], -3 )
			RETURN IF ( MAX ( DimTiempo[Fecha] ) > _corte, [Venta Perdida Supply Chain] )
		formatString: $ #,0
		lineageTag: 2a5a101d-2cd1-4124-a36b-c94c0184c756

	measure 'Venta Perdida Resto Supply Chain' =
			VAR _corte = EOMONTH ( [Fecha Ancla Supply Chain], -3 )
			RETURN IF ( MAX ( DimTiempo[Fecha] ) <= _corte, [Venta Perdida Supply Chain] )
		formatString: $ #,0
		lineageTag: 10247ad9-62ea-408d-ae39-08090341b19a

	measure 'Venta Perdida Promedio Mensual Supply Chain' =
			VAR _ancla = [Fecha Ancla Supply Chain]
			RETURN CALCULATE ( AVERAGEX ( VALUES ( DimTiempo[MesAnio] ), [Venta Perdida Supply Chain] ), DimTiempo[Fecha] <= _ancla )
		formatString: $ #,0
		lineageTag: 8bf39ae6-8e80-4054-b2b9-9fbe24a03b7a

	measure 'Color Duracion Fondo Supply Chain' =
			SWITCH (
			    TRUE (),
			    [Duración Promedio Supply Chain] >= [Umbral Racha Critica Supply Chain], "#FEE2E2",
			    [Duración Promedio Supply Chain] >= [Umbral Racha Moderada Supply Chain], "#FEF3C7",
			    "#EEF1F0"
			)
		lineageTag: d40799f9-3108-4e98-b0a9-4235ddf8dd92

	measure 'Venta Perdida M Supply Chain' = DIVIDE ( [Venta Perdida Supply Chain], 1000000 )
		formatString: \$ #,0.00\ "M"
		lineageTag: 6b1dd36a-693e-41cc-b701-13676613928d

	measure 'Venta Perdida Racha K Supply Chain' = DIVIDE ( [Venta Perdida Racha Supply Chain], 1000 )
		formatString: \$ #,0.0\ "K"
		lineageTag: e3d7fe35-389c-4c22-a360-a586a8bf9387

	measure 'Fecha Ancla Fidelización' =
			-- Fin del período seleccionado, sin pasarse de la última venta cargada
			VAR _k = CALCULATE ( MAX ( FactVentas[TiempoKey] ), REMOVEFILTERS () )
			VAR _UltVenta = DATE ( INT ( _k / 10000 ), INT ( MOD ( _k, 10000 ) / 100 ), MOD ( _k, 100 ) )
			RETURN MIN ( CALCULATE ( MAX ( DimTiempo[Fecha] ), ALLSELECTED ( DimTiempo ) ), _UltVenta )
		lineageTag: e41c1b59-ade8-41ba-9f39-821cf57a5083

	measure 'Ingreso en Riesgo Maduro Fidelización' =
			VAR _corte = [Fecha Ancla Fidelización] - [Días Maduración Fuga Fidelización]
			RETURN IF ( MAX ( DimTiempo[Fecha] ) <= _corte, [Ingreso en Riesgo Fidelización] )
		formatString: $ #,0
		lineageTag: d4ddf8bd-1a80-4d87-afe3-a1e445131705

	measure 'Ingreso en Riesgo En Maduración Fidelización' =
			VAR _corte = [Fecha Ancla Fidelización] - [Días Maduración Fuga Fidelización]
			RETURN IF ( MAX ( DimTiempo[Fecha] ) > _corte, [Ingreso en Riesgo Fidelización] )
		formatString: $ #,0
		lineageTag: cf85278f-2612-4eb3-a7b2-c98a502bafd4

	measure 'Ingreso en Riesgo Tramo Fidelización' =
			-- Una fila = segmento x tramo; devuelve 0 (no vacío) para que las 4 series de la leyenda siempre existan
			VAR _t = SELECTEDVALUE ( DimTramoRecencia[Tramo] )
			VAR _s = SELECTEDVALUE ( DimSegmentoFidelizacion[Segmento] )
			RETURN CALCULATE ( [Ingreso en Riesgo Fidelización], ClientesFugados[TramoRecencia] = _t, ClientesFugados[SegmentoCliente] = _s ) + 0
		formatString: #,0;-#,0;
		lineageTag: c3152871-bfa1-4e9a-8781-bd62e77ea557

	measure 'Tasa Recuperación Canal Descuento Fidelización' =
			-- Una columna = canal x descuento; devuelve 0 si no hubo acciones, así las 3 series siempre existen
			VAR _c = SELECTEDVALUE ( DimCanalFidelizacion[Canal] )
			VAR _p = SELECTEDVALUE ( DimDescuentoFidelizacion[Pct] )
			RETURN COALESCE ( CALCULATE ( [Tasa Recuperación 60d], AccionRetencion[Canal] = _c, AccionRetencion[PctDescuento] = _p ), 0 )
		formatString: 0\ %
		lineageTag: c6b69689-c8c2-4a8d-804e-1f4a23193ac7

	measure 'Contactados Canal Descuento Fidelización' =
			VAR _c = SELECTEDVALUE ( DimCanalFidelizacion[Canal] )
			VAR _p = SELECTEDVALUE ( DimDescuentoFidelizacion[Pct] )
			RETURN COALESCE ( CALCULATE ( [Contactados Fidelización], AccionRetencion[Canal] = _c, AccionRetencion[PctDescuento] = _p ), 0 )
		formatString: 0
		lineageTag: b5b823ba-d130-4a9d-a6fd-93b30ed6978e

	measure 'Color Segmento Fidelización' =
			SWITCH (
			    MAX ( ClientesFugados[SegmentoCliente] ),
			    "Premium", "#7C5CBF",
			    "Frecuente", "#2F9C77",
			    "Ocasional", "#B08968",
