	measure '% Rachas Criticas Supply Chain' =
			VAR _Umbral = [Umbral Racha Critica Supply Chain]
			VAR Criticas = COALESCE ( CALCULATE ( COUNTROWS ( RachasQuiebre ), RachasQuiebre[SnapshotsEnQuiebre] >= _Umbral ), 0 )
			RETURN DIVIDE ( Criticas, COUNTROWS ( RachasQuiebre ) )
		formatString: 0%
