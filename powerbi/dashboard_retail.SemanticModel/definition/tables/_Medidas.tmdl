	measure 'Zona Cuadrante' =
			
			VAR VarNominal  = [Var % Nominal YoY]
			VAR VarUnidades = [Var % Unidades YoY]
			VAR Inflacion   = [Inflación Anual Esperada]
			RETURN
			    SWITCH (
			        TRUE (),
			        VarUnidades > 0, "Crece de verdad",
			        VarNominal > Inflacion, "Solo remarca precios",
			        "Cae disfrazado de crecimiento"
			    )
		lineageTag: 493409fc-b2b4-4df1-9b86-303f86820981

	measure 'Selector Métrica MM3' = ```
			
			VAR Opcion  = MAX ( 'Selector Métrica'[Selector Métrica Orden] )
			VAR AnioMax = CALCULATE ( MAX ( DimTiempo[Anio] ), ALL ( DimTiempo ) )
			RETURN
			    IF (
			        SELECTEDVALUE ( DimTiempo[Anio] ) = AnioMax,
			        CALCULATE (
			            AVERAGEX (
			                VALUES ( DimTiempo[MesIndice] ),
			                CALCULATE (
			                    SWITCH (
			                        Opcion,
			                        0, [Var % Nominal YoY],
			                        1, [Var % Moneda Constante YoY],
			                        [Var % Unidades YoY]
			                    )
			                )
			            ),
			            DATESINPERIOD ( DimTiempo[Fecha], MAX ( DimTiempo[Fecha] ), -3, MONTH )
			        )
			    )
			
			```
		lineageTag: 6e8df2c1-13d6-4451-8fb6-054bb2c432bb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selector Métrica Valor' =
			
			SWITCH (
			    MAX ( 'Selector Métrica'[Selector Métrica Orden] ),
			    0, [Var % Nominal YoY],
			    1, [Var % Moneda Constante YoY],
			    [Var % Unidades YoY]
			)
		lineageTag: 7a2c9d41-5e68-4f03-b1f7-8c6d2a904e17

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Var % Nominal YoY Página 2' =
			
			VAR AnioActual = MAX ( DimTiempo[Anio] )
			VAR MesActual = MAX ( DimTiempo[Mes] )
			VAR UsaContextoMensual = HASONEVALUE ( DimTiempo[Mes] )
			VAR Actual =
			    IF (
			        UsaContextoMensual,
			        CALCULATE (
			            [Venta Neta],
			            REMOVEFILTERS ( DimTiempo ),
			            DimTiempo[Anio] = AnioActual,
			            DimTiempo[Mes] = MesActual
			        ),
			        CALCULATE (
			            [Venta Neta],
			            REMOVEFILTERS ( DimTiempo ),
			            DimTiempo[Anio] = AnioActual
			        )
			    )
			VAR Previo =
			    IF (
			        UsaContextoMensual,
			        CALCULATE (
			            [Venta Neta],
			            REMOVEFILTERS ( DimTiempo ),
			            DimTiempo[Anio] = AnioActual - 1,
			            DimTiempo[Mes] = MesActual
			        ),
			        CALCULATE (
			            [Venta Neta],
			            REMOVEFILTERS ( DimTiempo ),
			            DimTiempo[Anio] = AnioActual - 1
			        )
			    )
			RETURN DIVIDE ( Actual - Previo, Previo )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 64b80db9-4d16-4f0a-8f6f-4a3c26b89e0f

	measure 'Var % Unidades YoY Página 2' =
			
			VAR AnioActual = MAX ( DimTiempo[Anio] )
			VAR MesActual = MAX ( DimTiempo[Mes] )
			VAR UsaContextoMensual = HASONEVALUE ( DimTiempo[Mes] )
			VAR Actual =
			    IF (
			        UsaContextoMensual,
			        CALCULATE (
			            [Unidades],
			            REMOVEFILTERS ( DimTiempo ),
			            DimTiempo[Anio] = AnioActual,
			            DimTiempo[Mes] = MesActual
			        ),
			        CALCULATE (
			            [Unidades],
			            REMOVEFILTERS ( DimTiempo ),
			            DimTiempo[Anio] = AnioActual
			        )
			    )
			VAR Previo =
			    IF (
			        UsaContextoMensual,
			        CALCULATE (
			            [Unidades],
			            REMOVEFILTERS ( DimTiempo ),
			            DimTiempo[Anio] = AnioActual - 1,
			            DimTiempo[Mes] = MesActual
			        ),
			        CALCULATE (
			            [Unidades],
			            REMOVEFILTERS ( DimTiempo ),
			            DimTiempo[Anio] = AnioActual - 1
			        )
			    )
			RETURN DIVIDE ( Actual - Previo, Previo )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 77c92a15-1e0e-4f2c-b3b1-4a0d2c79110a

	measure 'Selector Métrica Valor Página 2' =
			
			SWITCH (
			    MAX ( 'Selector Métrica'[Selector Métrica Orden] ),
			    0, [Var % Nominal YoY Página 2],
			    1, [Var % Moneda Constante YoY Página 2],
			    [Var % Unidades YoY Página 2]
			)
		formatString: +0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 8d6f2d0f-8af2-47e2-9b75-10c8a81e46d88

	measure 'Venta Perdida Supply Chain' =
			VAR _meses = VALUES ( DimTiempo[MesIndice] )
			RETURN
			CALCULATE (
			    SUMX (
			        RachasQuiebre,
			        VAR _ini = YEAR ( RachasQuiebre[MesInicio] ) * 12 + MONTH ( RachasQuiebre[MesInicio] )
			        VAR _fin = YEAR ( RachasQuiebre[MesFin] ) * 12 + MONTH ( RachasQuiebre[MesFin] )
			        VAR _n = COUNTROWS ( FILTER ( _meses, DimTiempo[MesIndice] >= _ini && DimTiempo[MesIndice] <= _fin ) )
			        RETURN DIVIDE ( RachasQuiebre[VentaPerdidaEstimada], RachasQuiebre[SnapshotsEnQuiebre] ) * _n
			    ),
			    REMOVEFILTERS ( DimTiempo )
			)
		formatString: $ #,0
		lineageTag: 4a0cb5b1-2cb8-4de3-8b65-9a1b9bc0b321

	measure 'Rachas Supply Chain' = COUNTROWS ( RachasQuiebre )
		formatString: 0
