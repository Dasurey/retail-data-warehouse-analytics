		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column NombreMes =
			
			SWITCH (
			    DimTiempo[Mes],
			    1, "Ene", 2, "Feb", 3, "Mar", 4, "Abr",
			    5, "May", 6, "Jun", 7, "Jul", 8, "Ago",
			    9, "Sep", 10, "Oct", 11, "Nov", 12, "Dic"
			)
		lineageTag: 79b65462-5443-4a97-95da-55e762917220
		summarizeBy: none
		sortByColumn: Mes

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column MesAnio = DimTiempo[NombreMes] & " " & RIGHT ( DimTiempo[Anio], 2 )
		dataType: string
		lineageTag: 4f6e2961-ea02-4130-8586-dc6a5f1324f2
		summarizeBy: none
		sortByColumn: MesIndice

