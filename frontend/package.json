{
  "name": "dw-supermercado-admin-web",
  "version": "1.0.0",
  "description": "Panel de Administracion del DW - React + TanStack Query + RHF/Zod",
  "type": "module",
  "scripts": {
    "start": "vite",
    "smoke": "esbuild scripts/render-smoke.jsx --bundle --packages=external --format=esm --platform=node --jsx=automatic --loader:.jsx=jsx --outfile=.smoke/render-smoke.mjs --log-level=warning && node .smoke/render-smoke.mjs",
    "dev": "vite",
    "lint": "eslint .",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.101.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.83.0",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.0",
    "vite": "^8.1.5"
  }
}
