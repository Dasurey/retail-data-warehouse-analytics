# --- SQL Server ---
DW_SERVER=localhost
DW_PORT=1433
DW_DATABASE=DW_Supermercado
DW_USER=api_admin
DW_PASSWORD=CAMBIAR
# Driver 18 / TLS: en desarrollo sin certificado dejar en true
DW_TRUST_CERT=true
DW_ENCRYPT=true
DW_CONNECT_TIMEOUT_MS=15000

# --- API ---
PUERTO=3001
CORS_ORIGEN=http://localhost:5173
# Secreto de firma JWT (en produccion: vault / secret manager, minimo 32 chars)
JWT_SECRET=CAMBIAR-por-un-secreto-largo-y-aleatorio
# SMTP para pruebas de correo reales. Sin esto, /api/canales/:id/probar de email responde 501.
# Gmail: usá una contraseña de aplicacion, no tu password normal.
# Ejemplo:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=tuusuario@gmail.com
#   SMTP_PASSWORD=abcd efgh ijkl mnop
#   SMTP_FROM=tuusuario@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Clave AES-256 para cifrar destinos de canales (64 chars hex). Generarla:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CIFRADO_CLAVE=
NIVEL_LOG=info
RATE_LIMIT_MAX=300

# --- Lanzador local del pipeline (opcional, recomendado en desarrollo) ---

# --- Runner embebido del pipeline (modo desarrollo) ---
# Con "Ejecutar ahora" la API lanza orquestador_pipeline.py como hijo.
# En produccion: ORQUESTADOR_AUTORUN=false (consume el cron o --watch).
ORQUESTADOR_AUTORUN=true
# ORQUESTADOR_PYTHON=python
# ORQUESTADOR_SCRIPT=..\pipeline\orquestador_pipeline.py